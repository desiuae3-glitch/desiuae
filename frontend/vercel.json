{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.utopicrx.com" }],
      "destination": "https://utopicrx.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/utopicrx-mockup/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/utopicrx-mockup/index.html"
    },
    {
      "source": "/returns-warranty.html",
      "destination": "/utopicrx-mockup/returns-warranty.html"
    },
    {
      "source": "/product-manuals.html",
      "destination": "/utopicrx-mockup/product-manuals.html"
    },
    {
      "source": "/returns-warranty",
      "destination": "/utopicrx-mockup/returns-warranty.html"
    },
    {
      "source": "/product-manuals",
      "destination": "/utopicrx-mockup/product-manuals.html"
    },
    {
      "source": "/products",
      "destination": "/utopicrx-mockup/products/index.html"
    },
    {
      "source": "/products/(.*)",
      "destination": "/utopicrx-mockup/products/$1"
    },
    {
      "source": "/theme.css",
      "destination": "/utopicrx-mockup/theme.css"
    },
    {
      "source": "/nav.js",
      "destination": "/utopicrx-mockup/nav.js"
    },
    {
      "source": "/privacy",
      "destination": "/utopicrx/privacy.html"
    },
    {
      "source": "/utopicrx-mockup",
      "destination": "/utopicrx-mockup/index.html"
    },
    {
      "source": "/utopicrx",
      "destination": "/utopicrx/index.html"
    },
    {
      "source": "/((?!utopicrx|utopicrx-mockup|popup|redesign-preview\\.html|sitemap\\.xml|robots\\.txt|favicon|assets|returns-warranty|product-manuals|products|privacy).*)",
      "destination": "/index.html"
    }
  ]
}
