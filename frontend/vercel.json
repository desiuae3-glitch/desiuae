{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.utopicrx.com" }],
      "destination": "https://utopicrx.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/best-smart-locks-dubai-apartments-2026",
      "destination": "/blog/smart-lock-buyers-guide-dubai-2026",
      "permanent": true
    },
    {
      "source": "/utopicrx",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/utopicrx/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/utopicrx/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/utopic-rx.html",
      "destination": "/products/utopic-r",
      "permanent": true
    },
    {
      "source": "/products/utopic-r.html",
      "destination": "/products/utopic-r",
      "permanent": true
    },
    {
      "source": "/compare/desi-vs-nuki",
      "destination": "/compare/utopic-r-vs-nuki",
      "permanent": true
    },
    {
      "source": "/compare/desi-vs-yale",
      "destination": "/compare/utopic-r-vs-yale",
      "permanent": true
    },
    {
      "source": "/compare/desi-vs-philips",
      "destination": "/compare/utopic-r-vs-philips",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/theme.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/content.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/products/product.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/utopicrx-mockup/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/utopicrx-mockup/((?!robots\\.txt|llms\\.txt).*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/faq", "destination": "/utopicrx-mockup/faq.html" },
    { "source": "/smart-lock-rented-apartment", "destination": "/utopicrx-mockup/smart-lock-rented-apartment.html" },
    { "source": "/airbnb-smart-lock-dubai", "destination": "/utopicrx-mockup/airbnb-smart-lock-dubai.html" },
    { "source": "/smart-lock-installation-dubai", "destination": "/utopicrx-mockup/smart-lock-installation-dubai.html" },
    { "source": "/smart-lock-sharjah", "destination": "/utopicrx-mockup/smart-lock-sharjah.html" },
    { "source": "/smart-lock-abu-dhabi", "destination": "/utopicrx-mockup/smart-lock-abu-dhabi.html" },
    { "source": "/retrofit-lock-uae", "destination": "/utopicrx-mockup/seo/retrofit-lock-uae.html" },
    { "source": "/retrofit-lock-dubai", "destination": "/utopicrx-mockup/seo/retrofit-lock-dubai.html" },
    { "source": "/smartlock", "destination": "/utopicrx-mockup/seo/smartlock.html" },
    { "source": "/blog", "destination": "/utopicrx-mockup/blog/index.html" },
    { "source": "/blog/smart-lock-rented-apartment-dubai", "destination": "/utopicrx-mockup/blog/smart-lock-rented-apartment-dubai.html" },
    { "source": "/blog/smart-lock-buyers-guide-dubai-2026", "destination": "/utopicrx-mockup/blog/smart-lock-buyers-guide-dubai-2026.html" },
    { "source": "/compare/utopic-r-vs-nuki", "destination": "/utopicrx-mockup/compare/utopic-r-vs-nuki.html" },
    { "source": "/compare/utopic-r-vs-yale", "destination": "/utopicrx-mockup/compare/utopic-r-vs-yale.html" },
    { "source": "/compare/utopic-r-vs-philips", "destination": "/utopicrx-mockup/compare/utopic-r-vs-philips.html" },
    { "source": "/compare/utopic-r-vs-smart-centrum", "destination": "/utopicrx-mockup/compare/utopic-r-vs-smart-centrum.html" },
    { "source": "/theme.css", "destination": "/utopicrx-mockup/theme.css" },
    { "source": "/content.css", "destination": "/utopicrx-mockup/content.css" },
    { "source": "/nav.js", "destination": "/utopicrx-mockup/nav.js" },
    { "source": "/analytics.js", "destination": "/utopicrx-mockup/analytics.js" },
    { "source": "/products/product.css", "destination": "/utopicrx-mockup/products/product.css" },
    { "source": "/", "destination": "/utopicrx-mockup/index.html" },
    { "source": "/returns-warranty.html", "destination": "/utopicrx-mockup/returns-warranty.html" },
    { "source": "/product-manuals.html", "destination": "/utopicrx-mockup/product-manuals.html" },
    { "source": "/returns-warranty", "destination": "/utopicrx-mockup/returns-warranty.html" },
    { "source": "/product-manuals", "destination": "/utopicrx-mockup/product-manuals.html" },
    { "source": "/products/utopic-r", "destination": "/utopicrx-mockup/products/utopic-rx.html" },
    { "source": "/products", "destination": "/utopicrx-mockup/products/index.html" },
    { "source": "/products/(.*)", "destination": "/utopicrx-mockup/products/$1" },
    { "source": "/privacy", "destination": "/utopicrx/privacy.html" },
    { "source": "/privacy.html", "destination": "/utopicrx/privacy.html" },
    { "source": "/404", "destination": "/utopicrx-mockup/404.html" },
    { "source": "/utopicrx-mockup", "destination": "/utopicrx-mockup/index.html" },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|llms\\.txt).*)",
      "destination": "/404.html",
      "statusCode": 404
    }
  ]
}
